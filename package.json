{
  "name": "fastify-ts-fullstack",
  "version": "1.0.0",
  "description": "Fullstack TypeScript project with Fastify and client-side TS modules",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server.js",
    "dev:server": "nodemon --exec ts-node src/server.ts",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/lib-storage": "^3.1051.0",
    "@aws-sdk/s3-request-presigner": "^3.1051.0",
    "@fastify/static": "^10.1.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20.19.43",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
